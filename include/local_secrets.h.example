// Copy this file to include/local_secrets.h and fill in your own values.
//
//     cp include/local_secrets.h.example include/local_secrets.h
//
// local_secrets.h is gitignored, so your printer's access code never reaches
// the repository. It is entirely optional: leave it out and configure the
// printer through the web UI instead, which stores the values in NVS where
// they survive reflashes.
//
// These only seed NVS on a board that has never been configured. Once a value
// has been saved, the stored one wins and changing it here does nothing until
// you run `pio run -e wroom32 -t erase`.

#pragma once

// Printer IP address on your LAN.
#define MQTT_HOST_DEFAULT "192.168.1.50"

// LAN Access Code: printer screen -> Settings -> Network.
// Rotates whenever you toggle LAN mode.
#define MQTT_PASSWORD_DEFAULT "00000000"

// Printer serial: Settings -> Device, or read it off the MQTT report topic.
#define MQTT_SERIAL_DEFAULT "00M00A0000000000"
